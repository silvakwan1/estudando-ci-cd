{
  "name": "estudando-ci-cd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run lint && npm run format:check && next build",
    "vercel:var": "vercel pull --yes --environment=production --token=$VERCEL_TOKEN",
    "vercel:build": "vercel build --prod --token=$VERCEL_TOKEN",
    "vercel:deploy": "vercel deploy --prebuilt --prod --token=$VERCEL_TOKEN"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5"
  }
}
